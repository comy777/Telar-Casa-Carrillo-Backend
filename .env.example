# PostgreSQL local
POSTGRES_DB=telar_casa_carrillo
POSTGRES_USER=telar_app
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://telar_app:change_this_local_password@localhost:5432/telar_casa_carrillo?schema=public

# API
API_PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# URLs públicas (redirecciones de pago, enlaces en correos)
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:3001
# Para los proyectos Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001

# Identidad
# Secreto para firmar los access tokens (mínimo 32 caracteres). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
# Los refresh tokens son aleatorios y se guardan como hash; no usan secreto.
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Versión de la política de tratamiento de datos vigente (se guarda al registrarse)
PRIVACY_POLICY_VERSION=2026-11

# Imágenes del catálogo
# Con CLOUDINARY_CLOUD_NAME se suben a Cloudinary (obligatorio en producción).
# Sin él, en desarrollo se guardan en MEDIA_LOCAL_DIR y la API las sirve en /media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=telar-casa-carrillo
MEDIA_LOCAL_DIR=uploads

# Pagos (Wompi) — usar sandbox inicialmente
# Las cuatro llaves se configuran juntas y deben ser del ambiente de WOMPI_API_URL:
#   sandbox → pub_test_, prv_test_, test_events_, test_integrity_
#   producción → pub_prod_, prv_prod_, prod_events_, prod_integrity_
# Sin llaves (solo fuera de producción) los pagos responden 503.
# En el panel de Wompi, la URL de eventos es: <API_PUBLIC_URL>/api/v1/payments/webhooks/wompi
PAYMENT_PROVIDER=wompi
# Sandbox: https://sandbox.wompi.co/v1 — Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Firma de integridad de la transacción (widget/checkout)
WOMPI_INTEGRITY_SECRET=
# Mercado Pago: aún sin adaptador (PAYMENT_PROVIDER solo admite wompi)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Carrito e inventario
# Minutos que el stock queda apartado al iniciar el checkout (5 a 60)
CHECKOUT_RESERVATION_MINUTES=15
# Días sin cambios tras los que se borra un carrito de invitado
GUEST_CART_TTL_DAYS=30
# Procesos programados (por defecto activos salvo en pruebas)
JOBS_ENABLED=

# Pedidos
# Minutos para pagar un pedido antes de cancelarlo y devolver el stock (10 a 1440)
ORDER_PAYMENT_MINUTES=60
ORDER_NUMBER_PREFIX=TCC
# IVA incluido en el costo de envío (confirmar con el contador)
SHIPPING_TAX_RATE=0.19

# Facturación electrónica DIAN — proveedor tecnológico por definir
EINVOICE_PROVIDER=
EINVOICE_API_URL=
EINVOICE_API_KEY=

# Email — sin SMTP_HOST (solo en desarrollo) los correos se escriben en el log de la API
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
