# PostgreSQL local
POSTGRES_DB=telar_casa_carrillo
POSTGRES_USER=telar_app
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://telar_app:change_this_local_password@localhost:5432/telar_casa_carrillo?schema=public

# API
API_PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# URLs públicas (redirecciones de pago, enlaces en correos)
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:3001
# Para los proyectos Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth — generar secretos seguros fuera del repositorio
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments — usar sandbox inicialmente
PAYMENT_PROVIDER=wompi
# Sandbox: https://sandbox.wompi.co/v1 — Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Firma de integridad de la transacción (widget/checkout)
WOMPI_INTEGRITY_SECRET=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta para validar la firma de las notificaciones (webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Facturación electrónica DIAN — proveedor tecnológico por definir
EINVOICE_PROVIDER=
EINVOICE_API_URL=
EINVOICE_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
